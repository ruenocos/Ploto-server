{
  "name": "ploto-server",
  "version": "0.1.0",
  "private": true,
  "description": "Clean-room reimplementation of the Plato game server (Match Monsters first).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dump": "tsx src/tools/bundleDumper/cli.ts",
    "sim": "npm run build && node scripts/balance-sim.mjs"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "fflate": "^0.8.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
