{
  "name": "ploto-server",
  "version": "0.1.0",
  "private": true,
  "description": "Clean-room reimplementation of the Plato game server (Match Monsters first).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dump": "tsx src/tools/bundleDumper/cli.ts",
    "sim": "npm run build && node scripts/balance-sim.mjs",
    "tiers": "npm run build && node scripts/monster-tiers.mjs",
    "duos": "npm run build && node scripts/duo-sim.mjs",
    "lab": "node scripts/lab-report.mjs",
    "sounds": "node scripts/gen-sounds.mjs",
    "blasts": "npm run build && node scripts/blast-randomness.mjs",
    "holdem": "npm run build && node scripts/holdem-sim.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "animate.css": "4.1.1",
    "fastify": "^5.1.0",
    "fflate": "^0.8.2",
    "jsfxr": "1.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
